# Opros: шаблон production-настроек. Не коммитьте заполненный .env.
# Секреты можно сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"

COMPOSE_PROJECT_NAME=opros
ENVIRONMENT=production
DEBUG=false
ENABLE_API_DOCS=false

# Публичный адрес одного инстанса клиники
FRONTEND_URL=https://survey.example.ru
CORS_ORIGINS_STR=https://survey.example.ru

# Независимые случайные секреты (минимум 32 символа)
SECRET_KEY=CHANGE-ME-generate-an-independent-random-secret
JWT_SECRET_KEY=CHANGE-ME-generate-another-independent-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=48
SESSION_TTL=604800

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=opros_user
POSTGRES_PASSWORD=CHANGE-ME-generate-a-database-password
POSTGRES_DB=opros_db

# Redis (обязательный пароль в production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-generate-a-redis-password

# Админ-панель
ADMIN_USERNAME=CHANGE-ME-clinic-operator
ADMIN_PASSWORD=CHANGE-ME-generate-an-admin-password

# Ограничения и сроки хранения
RATE_LIMIT_PER_MINUTE=60
AUDIT_LOG_RETENTION_HOURS=24
DATA_RETENTION_HOURS=24

# Bitrix24. Секретный webhook URL и токены хранить только в secret manager/.env.
BITRIX24_WEBHOOK_URL=
BITRIX24_CRM_FIELDS_WEBHOOK_URL=
BITRIX24_INCOMING_TOKEN=CHANGE-ME-generate-an-incoming-token
BITRIX24_ALLOWED_CATEGORIES=
BITRIX24_DEFAULT_RESPONSIBLE_ID=0
BITRIX24_SURVEY_LINK_FIELD=UF_CRM_REPLACE_ME

# AI-анализ по умолчанию отключён. Включать только после проверки договора и ZDR.
AI_ANALYSIS_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:nitro
OPENROUTER_TIMEOUT_SECONDS=90
AI_ANALYSIS_MAX_ATTEMPTS=5
AI_ANALYSIS_PROMPT_VERSION=v1
AI_ANALYSIS_ZDR_REQUIRED=true
